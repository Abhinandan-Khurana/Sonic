<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="room">#FFF4F4F2</color>
    <color name="ink">#FF111111</color>

    <style name="Theme.Runout" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/room</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        The launch screen's theme when Settings › Flags › theme pins light or dark (MainActivity sets
        it, Android 13 and later), so the room's own paper shows from the first frame, whatever the phone.
    -->
    <style name="Theme.Runout.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Runout.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
