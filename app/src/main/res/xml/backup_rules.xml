<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- SAF grants are not restored with preferences. Require fresh folder selection and setup. -->
    <exclude domain="sharedpref" path="library.xml" />
    <exclude domain="sharedpref" path="soulseek.xml" />
    <exclude domain="sharedpref" path="soulseek-setup.xml" />
    <exclude domain="sharedpref" path="soulseek_credentials.xml" />
    <exclude domain="sharedpref" path="account.xml" />
    <exclude domain="database" path="soulseek.db" />
    <exclude domain="database" path="soulseek.db-wal" />
    <exclude domain="database" path="soulseek.db-shm" />
</full-backup-content>
