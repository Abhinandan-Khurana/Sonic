                "mObw5": {
                  "content": "CLAIMS"
                },
                "D7Vij": {
                  "content": "you get three claims a week. each one adds a drop to your crate for good."
                },
                "J6aDyd": {
                  "content": "everyone sees the same ten albums each friday."
                },
                "o3X6U": {
                  "content": "listening to the 30 s previews never uses a claim."
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "d3Hs6",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · background usage is off",
              "descendants": {
                "W1m2E": {
                  "content": "help · downloads"
                },
                "mObw5": {
                  "content": "BACKGROUND USAGE IS OFF"
                },
                "D7Vij": {
                  "content": "android pauses runout's downloads as soon as you leave the app."
                },
                "J6aDyd": {
                  "content": "allow background usage in app info › battery to let them finish while the phone sleeps. paused downloads continue when you come back."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
