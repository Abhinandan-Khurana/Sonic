              }
            },
            {
              "id": "qHvpy",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · the crate",
              "descendants": {
                "W1m2E": {
                  "content": "help · room · first time"
                },
                "mObw5": {
                  "content": "THE CRATE"
                },
                "D7Vij": {
                  "content": "flick left or right to browse. tap a sleeve or pull it up to take the record out."
                },
                "J6aDyd": {
                  "content": "drag the record onto the platter to play it. tap it to flip the side, hold it to slow it down."
                },
                "o3X6U": {
                  "content": "long-press a sleeve for the record menu: details, put back, remove."
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "EYHJa",
              "type": "ref",
              "ref": "zQnG4",
