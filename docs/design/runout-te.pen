              "id": "xWvYD",
              "name": "Paragraph",
              "fill": "$quiet",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Keep your password somewhere safe: Soulseek can't reset it. Signing in here signs out any other app using the same ID.",
              "lineHeight": 1.2727272727272727,
              "fontFamily": "Array",
              "fontSize": 11,
