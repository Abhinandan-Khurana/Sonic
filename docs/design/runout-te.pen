              "name": "Paragraph",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Soulseek has no sign-up page. Your ID is created the first time you sign in with it.",
              "lineHeight": 1.2727272727272727,
              "fontFamily": "Array",
              "fontSize": 11,
              "fontWeight": "normal",
              "letterSpacing": 0.1
            },
            {
              "type": "text",
              "id": "U2B3q",
              "name": "Paragraph",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "New here? Type the ID you'd like and a password, then Connect. If Soulseek says the password is wrong, that ID already belongs to someone: try another one.",
              "lineHeight": 1.2727272727272727,
              "fontFamily": "Array",
              "fontSize": 11,
              "fontWeight": "normal",
              "letterSpacing": 0.1
            },
