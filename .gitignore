# New APKs are published as GitHub release assets.
release/Runout-*-development.apk
release/Sonic-*.apk

# Local Argent credentials and generated test artifacts.
.argent/secrets.env
.argent/artifacts/
.argent/reports/
node_modules/

# Python bytecode (Blender scripts)
